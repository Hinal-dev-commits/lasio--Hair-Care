{%- assign s = section.settings -%}
{%- style -%}
  #shopify-section-{{ section.id }} .nw-section {
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
    {%- case s.bg_type -%}
      {%- when 'color' -%}
        {%- if s.bg_color != blank %}
    background: {{ s.bg_color }};
        {%- endif -%}
      {%- when 'gradient' -%}
        {%- if s.bg_gradient != blank %}
    background: {{ s.bg_gradient }};
        {%- endif -%}
      {%- when 'image' -%}
        {%- if s.bg_image != blank %}
    background-image: url('{{ s.bg_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
        {%- endif -%}
    {%- endcase %}
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .nw-section {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}
